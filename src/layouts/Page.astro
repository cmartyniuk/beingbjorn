---
import '../styles/site.css';
const { title = "It's Not Easy Being Bjorn", current = '' } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#fbf6e9"/><title>{title}</title><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/></head>
<body><div class="page"><header class="header"><a href="/" class="logo" aria-label="It's Not Easy Being Bjorn">It's Not Easy<span>Being Bjorn</span></a><nav class="nav" aria-label="Main navigation">{[['/', 'latest'], ['/archive/', 'archive'], ['/about/', 'about']].map(([href,label]) => <a href={href} aria-current={current === label ? 'page' : undefined}>{label}</a>)}</nav></header><div class="scribble" aria-hidden="true"></div><main><slot/></main><footer class="footer"><div class="doodle" aria-hidden="true">✳</div>© {new Date().getFullYear()} It's Not Easy Being Bjorn</footer></div></body></html>
